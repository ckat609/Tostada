# Google OAuth Client ID
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Sheets Spreadsheet ID
# Found in the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
VITE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

# Sheet name (tab name) within the spreadsheet
VITE_SHEETS_SHEET_NAME=Ventas
