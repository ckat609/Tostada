# Microsoft Entra application registration
VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Use "common" for work/school + personal Microsoft accounts.
# Use your tenant ID when the app should be restricted to one organization.
VITE_MS_TENANT_ID=common

# Must exactly match a redirect URI configured in Entra.
VITE_MS_REDIRECT_URI=http://localhost:5173

# Workbook location. Use ONE of the supported configurations below.

# A) Workbook in the signed-in user's OneDrive
VITE_EXCEL_FILE_PATH=/Apps/MyApp/data.xlsx

# B) Workbook addressed by Graph IDs (SharePoint or another drive)
# VITE_EXCEL_DRIVE_ID=
# VITE_EXCEL_ITEM_ID=

# Excel table name inside the workbook
VITE_EXCEL_TABLE_NAME=Entries
